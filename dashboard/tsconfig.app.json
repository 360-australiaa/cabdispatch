{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    // `test.globals` is on in vite.config.ts, so describe/it/expect are
    // injected rather than imported; this is what tells tsc they exist.
    // jest-dom's matchers (toHaveClass, toBeDisabled, ...) come with it via
    // the `@testing-library/jest-dom/vitest` import in src/setupTests.ts.
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
