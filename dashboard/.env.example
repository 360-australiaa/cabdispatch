# Backend base URL (no trailing slash, no /v1 suffix — routes are called as /v1/...)
VITE_API_URL=http://localhost:8001

# Mapbox GL JS public token (pk.*) for the Live Map's real map tiles. Public/publishable by
# Mapbox's own design (safe to ship in a client bundle) but still per-account and rate/billing
# limited — get your own at https://account.mapbox.com/access-tokens/, don't share one across
# unrelated projects. Live Map falls back to the old canvas placeholder if this is unset.
#
# It is read at BUILD time (Vite inlines VITE_* into the bundle), so setting it after a build
# changes nothing until the dashboard is rebuilt. Three places degrade without it, all with a
# real fallback rather than an error: Live Map (canvas placeholder), the Toll Zones centre picker
# (plain lat/lng inputs), and Tariff Studio's "NSW Toll Roads" gantry map (a plain coordinate
# table — the toll pinpoints stay readable, just not plotted).
VITE_MAPBOX_TOKEN=
