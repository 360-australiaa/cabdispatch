# Backend base URL (no trailing slash, no /v1 suffix — routes are called as /v1/...)
VITE_API_URL=http://localhost:8001

# Mapbox GL JS public token (pk.*) for the Live Map's real map tiles. Public/publishable by
# Mapbox's own design (safe to ship in a client bundle) but still per-account and rate/billing
# limited — get your own at https://account.mapbox.com/access-tokens/, don't share one across
# unrelated projects. Live Map falls back to the old canvas placeholder if this is unset.
VITE_MAPBOX_TOKEN=
