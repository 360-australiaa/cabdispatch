<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backend sync (Retrofit/OkHttp) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Fare engine GPS fusion (B6): foreground fine location while HIRED,
         background so a trip can keep ticking if the app is backgrounded
         mid-fare (e.g. driver briefly switches app for navigation). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- QR vehicle pairing (S1) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Duress audio recording (Blueprint §4.3/§8.3) — best-effort: RECORD_AUDIO ungranted is a
         graceful no-op (domain/duress/DuressAudioRecorder.kt), never a crash. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Sync/duress/shift-report notifications (Android 13+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CabDispatchApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CabDispatch"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CabDispatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sibling agent (offline sync engine): register the WorkManager
             sync worker's provider here if a custom Configuration.Provider is
             needed, or rely on default WorkManager init since CabDispatchApp
             does not implement Configuration.Provider yet. -->

    </application>

</manifest>
