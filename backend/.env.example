# Copy to .env and fill in real values for your environment.
# Every setting here maps 1:1 to a field in app/core/config.py:Settings.

# development | staging | production
ENV=development

# --- Database ---
# Local dev (default, zero setup — sqlite file in the backend/ dir):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production (postgres:16-alpine via docker-compose.yml, host port 5433):
# DATABASE_URL=postgresql+asyncpg://cabdispatch:cabdispatch@localhost:5433/cabdispatch

# --- Redis (OPTIONAL — app boots and runs fine without it reachable) ---
# redis:7-alpine via docker-compose.yml, host port 6380:
REDIS_URL=redis://localhost:6380/0

# --- JWT / auth ---
JWT_SECRET=change-me-to-a-long-random-secret-in-every-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS --- (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5174"]

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_placeholder
