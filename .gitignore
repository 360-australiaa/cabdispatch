# --- Backend (Python / FastAPI / uv) ----------------------------------------
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc
backend/dev.db
backend/tests/test_dev.db
# SQLite rollback journal beside the test DB above -- same artefact, appears mid-run.
backend/tests/test_dev.db-journal
backend/uploads/
backend/.pytest_cache/
backend/.ruff_cache/
*.egg-info/

# Real secrets — only .env.example is tracked
.env
backend/.env
backend/.env.production
.env.production
!.env.production.example

# --- Dashboard (Vite / React / TS) ------------------------------------------
dashboard/node_modules/
dashboard/dist/
dashboard/tsconfig.app.tsbuildinfo
dashboard/tsconfig.node.tsbuildinfo
dashboard/.vite/
npm-debug.log*

# --- Android (Gradle / Kotlin) -----------------------------------------------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/*.iml
android/.idea/
android/captures/
android/.cxx/

# --- OS / editor ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
*.log

# Competitor reference screenshots (research only, not project deliverables — do not commit
# a competitor's proprietary product UI into this repo's history)
meter screens/
.idea/
*.apk

# Built APKs/AABs. The `*.apk` rule above already covers the file extension; this pins the
# directory release artifacts are staged in, so a whole build output tree (mapping.txt, .aab,
# unpacked dex) can never be committed either. Three ~145 MB APKs used to sit untracked in the
# repo root -- one careless stage-everything would have committed them, and the live driver
# credential inside them, permanently (docs/audits/2026-09-08-backend-audit.md section 5 addendum).
android/dist/
*.aab
