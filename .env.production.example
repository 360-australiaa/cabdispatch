# Copy to .env.production and fill in real values, then:
#   docker compose up -d --build
# See docs/DEPLOY_UBUNTU.md for the full runbook. Every setting here maps
# 1:1 to app/core/config.py:Settings (backend), except VITE_* (dashboard,
# build-time only) and POSTGRES_PASSWORD (docker-compose.yml's db service).
#
# *** Do not commit this file once filled in -- it holds real secrets. ***

# --- Postgres (docker-compose.yml's db service) ---
POSTGRES_PASSWORD=change-me-generate-a-real-random-password

# --- JWT / auth ---
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-REQUIRED-generate-a-real-secret-see-comment-above

# --- Secret-at-rest encryption key (app/core/crypto.py -- duress device
# shared secrets). Generate:
#   docker run --rm python:3.12-slim python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or run that one-liner locally if you have python+cryptography installed)
SECRET_ENCRYPTION_KEY=change-me-REQUIRED-generate-a-real-fernet-key-see-comment-above

# --- Tariff signing (Ed25519 anti-tamper signature over GET /v1/tariffs/active).
# Generate:
#   docker run --rm python:3.12-slim bash -c "pip install -q cryptography && python -c \"
#   import base64
#   from cryptography.hazmat.primitives.asymmetric import ed25519
#   from cryptography.hazmat.primitives import serialization
#   k = ed25519.Ed25519PrivateKey.generate()
#   print(base64.b64encode(k.private_bytes(
#       serialization.Encoding.DER, serialization.PrivateFormat.PKCS8,
#       serialization.NoEncryption())).decode())\""
TARIFF_SIGNING_PRIVATE_KEY=change-me-REQUIRED-generate-a-real-keypair-see-comment-above

# --- CORS --- (JSON array of allowed origins -- add your dashboard's real
# URL here, e.g. http://<server-ip> for a bare-IP deploy, or your real
# domain once you have one)
CORS_ORIGINS=["http://localhost:5180"]

# --- Dashboard build-time vars (Vite bakes these into the static bundle --
# see dashboard/Dockerfile) ---
VITE_API_URL=http://change-me-to-your-server-ip:8001
VITE_MAPBOX_TOKEN=

# --- Stripe (payments/subscriptions) -- leave as-is to run in mock-fallback
# mode (dashboard shows a "Simulated" badge on these rows) until you have a
# live key ---
STRIPE_SECRET_KEY=sk_test_placeholder

# --- SendGrid (receipt/notification email) -- empty = mock-fallback ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=receipts@cabdispatch.example

# --- Twilio (receipt SMS, duress escalation call, duress "call the cab") --
# all three required together for real Twilio; any one missing = mock-fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Deployment-wide default phone dialed when a duress escalation reaches its
# final stage, AND the call-centre bridge target for "call the cab" (see
# docs/DURESS_DEVICE_INTEGRATION.md). Empty = that step is skipped, not a
# bogus dial.
DURESS_ESCALATION_CALL_PHONE=
# Caller-ID used for the duress device call specifically; falls back to
# TWILIO_FROM_NUMBER if unset.
DURESS_CALL_FROM_NUMBER=

# --- CabCharge / TTSS -- leave as placeholders until you have real
# merchant/provider credentials (mock-fallback mode) ---
CABCHARGE_API_KEY=cabcharge_test_placeholder
CABCHARGE_BASE_URL=https://api.cabcharge.com.au/v2
CABCHARGE_MERCHANT_ID=merchant_test_placeholder
TTSS_API_KEY=ttss_test_placeholder
TTSS_BASE_URL=https://api.ttss.transport.nsw.gov.au/v1
TTSS_PROVIDER_ID=provider_test_placeholder

# --- Fatigue / compliance-expiry thresholds -- sane defaults, override if needed ---
FATIGUE_SHIFT_DURATION_LIMIT_HOURS=12.0
COMPLIANCE_EXPIRY_WARNING_DAYS=30

# --- Duress device JWT lifetime (minutes) -- sane default ---
DURESS_DEVICE_JWT_EXPIRE_MINUTES=60